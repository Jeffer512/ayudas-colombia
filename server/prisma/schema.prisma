generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  department String?
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  requests  Request[]
  offers    Offer[]
  avisos    Aviso[]
  acopios   AcopioCenter[]

  @@map("cities")
}

model Reporter {
  id               String   @id @default(uuid())
  name             String
  organizationName String?  @map("organization_name")
  organizationType String?  @map("organization_type")
  phone            String?
  whatsapp         String?
  email            String?
  createdAt        DateTime @default(now()) @map("created_at")
  requests         Request[]
  offers           Offer[]
  avisos           Aviso[]

  @@map("reporters")
}

model Request {
  id          String   @id @default(uuid())
  type        String
  urgency     String   @default("medium")
  transport   String?
  status      String   @default("open")
  title       String
  description String
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  resolveCode String   @default("0000") @map("resolve_code")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City           @relation(fields: [cityId], references: [id])
  reporter Reporter       @relation(fields: [reporterId], references: [id])
  events   RequestEvent[]
  helpers  RequestHelper[]

  @@index([cityId, status])
  @@index([type])
  @@map("requests")
}

model RequestEvent {
  id        BigInt   @id @default(autoincrement())
  requestId String   @map("request_id")
  status    String
  note      String?
  actorName String?  @map("actor_name")
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_events")
}

model RequestHelper {
  id        BigInt   @id @default(autoincrement())
  requestId String   @map("request_id")
  markerId  String?  @map("marker_id")
  name      String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, markerId])
  @@index([requestId])
  @@map("request_helpers")
}

model Offer {
  id          String   @id @default(uuid())
  type        String
  transport   String?
  status      String   @default("open")
  title       String
  description String
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  resolveCode String   @default("0000") @map("resolve_code")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id])
  reporter Reporter @relation(fields: [reporterId], references: [id])

  @@index([cityId, status])
  @@index([type])
  @@map("offers")
}

model Aviso {
  id          String   @id @default(uuid())
  type        String   @default("info")
  urgency     String   @default("medium")
  status      String   @default("open")
  title       String
  description String
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City        @relation(fields: [cityId], references: [id])
  reporter Reporter    @relation(fields: [reporterId], references: [id])
  marks    AvisoMark[]

  @@index([cityId, status])
  @@map("avisos")
}

model AvisoMark {
  id        BigInt   @id @default(autoincrement())
  avisoId   String   @map("aviso_id")
  markerId  String?  @map("marker_id")
  createdAt DateTime @default(now()) @map("created_at")

  aviso Aviso @relation(fields: [avisoId], references: [id], onDelete: Cascade)

  @@index([avisoId, markerId])
  @@map("avisos_marks")
}

model AcopioCenter {
  id           String   @id @default(uuid())
  type         String   @default("ciudadano")
  name         String
  description  String?
  address      String?
  lat          Float?
  lng          Float?
  cityId       Int      @map("city_id")
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  hours        String?
  accepts      String?
  status       String   @default("open")
  resolveCode  String   @default("0000") @map("resolve_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id])

  @@index([cityId, status])
  @@map("acopio_centers")
}