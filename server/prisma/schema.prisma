generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  name                 String
  passwordHash         String           @map("password_hash")
  emailVerifiedAt      DateTime?        @map("email_verified_at")
verifyTokenHash      String?        @map("verify_token_hash")
  verifyTokenExpiresAt DateTime?        @map("verify_token_expires_at")
  resetTokenHash       String?        @map("reset_token_hash")
  resetTokenExpiresAt  DateTime?      @map("reset_token_expires_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  memberships HelpOrgStaff[]
  claims      OfferClaim[]
  reporters   Reporter[]

  @@map("users")
}

model City {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  department String?
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  requests  Request[]
  offers    Offer[]
  avisos    Aviso[]
  helpOrgs  HelpOrg[]

  @@map("cities")
}

model Reporter {
  id               String   @id @default(uuid())
  userId           String?  @map("user_id")
  name             String
  organizationName String?  @map("organization_name")
  organizationType String?  @map("organization_type")
  phone            String?
  whatsapp         String?
  email            String?
  createdAt        DateTime @default(now()) @map("created_at")
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests         Request[]
  offers           Offer[]
  avisos           Aviso[]

  @@index([userId])
  @@map("reporters")
}

model Request {
  id          String   @id @default(uuid())
  type        String
  urgency     String   @default("medium")
  transport   String?
  status      String   @default("open")
  title       String
  description String
  photoUrl    String?  @map("photo_url")
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  helpOrgId   String?  @map("help_org_id")
  resolveCode String   @default("0000") @map("resolve_code")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City           @relation(fields: [cityId], references: [id])
  reporter Reporter       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  org      HelpOrg?       @relation(fields: [helpOrgId], references: [id], onDelete: SetNull)
  events   RequestEvent[]
  helpers  RequestHelper[]

  @@index([cityId, status])
  @@index([type])
  @@index([helpOrgId])
  @@map("requests")
}

model RequestEvent {
  id        BigInt   @id @default(autoincrement())
  requestId String   @map("request_id")
  status    String
  note      String?
  actorName String?  @map("actor_name")
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_events")
}

model RequestHelper {
  id        BigInt   @id @default(autoincrement())
  requestId String   @map("request_id")
  markerId  String?  @map("marker_id")
  name      String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, markerId])
  @@index([requestId])
  @@map("request_helpers")
}

model Offer {
  id          String   @id @default(uuid())
  type        String
  transport   String?
  status      String   @default("open")
  title       String
  description String
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  resolveCode String   @default("0000") @map("resolve_code")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City          @relation(fields: [cityId], references: [id])
  reporter Reporter      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  claims   OfferClaim[]

  @@index([cityId, status])
  @@index([type])
  @@map("offers")
}

model OfferClaim {
  id         String    @id @default(uuid())
  offerId    String    @map("offer_id")
  claimerId  String?   @map("claimer_id")
  status     String    @default("committed")
  note       String?
  claimedAt  DateTime  @default(now()) @map("claimed_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  claimer User? @relation(fields: [claimerId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([claimerId])
  @@map("offer_claims")
}

model Aviso {
  id          String   @id @default(uuid())
  type        String   @default("info")
  urgency     String   @default("medium")
  status      String   @default("open")
  title       String
  description String
  address     String?
  lat         Float?
  lng         Float?
  cityId      Int      @map("city_id")
  reporterId  String   @map("reporter_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city     City        @relation(fields: [cityId], references: [id])
  reporter Reporter    @relation(fields: [reporterId], references: [id])
  marks    AvisoMark[]

  @@index([cityId, status])
  @@map("avisos")
}

model AvisoMark {
  id        BigInt   @id @default(autoincrement())
  avisoId   String   @map("aviso_id")
  markerId  String?  @map("marker_id")
  createdAt DateTime @default(now()) @map("created_at")

  aviso Aviso @relation(fields: [avisoId], references: [id], onDelete: Cascade)

  @@index([avisoId, markerId])
  @@map("avisos_marks")
}

model HelpOrg {
  id           String   @id @default(uuid())
  type         String   @default("ciudadano")
  category     String   @default("acopio")
  name         String
  description  String?
  address      String?
  lat          Float?
  lng          Float?
  cityId       Int      @map("city_id")
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  hours        String?
  accepts      String?
  status       String   @default("open")
  resolveCode  String   @default("0000") @map("resolve_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city     City            @relation(fields: [cityId], references: [id])
  staff    HelpOrgStaff[]
  requests Request[]
  items    HelpOrgItem[]

  @@index([cityId, status])
  @@index([category])
  @@map("help_orgs")
}

model HelpOrgItem {
  id          String        @id @default(uuid())
  orgId       String        @map("org_id")
  kind        String        @default("available")
  name        String
  quantity    Int?
  unit        String?
  updatedById String?       @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  org       HelpOrg       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy HelpOrgStaff? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([orgId, kind])
  @@map("help_org_items")
}

model HelpOrgStaff {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  orgId      String    @map("org_id")
  role       String    @default("manager")
  status     String    @default("active")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  org  HelpOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedItems HelpOrgItem[]

  @@index([orgId])
  @@map("help_org_staff")
}