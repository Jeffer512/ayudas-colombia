# Base de datos
DATABASE_URL=postgresql://ayudas:ayudas@localhost:5432/ayudas
DATABASE_URL_TEST=postgresql://ayudas:ayudas@localhost:5432/ayudas_test
PORT=4000

# Entorno de ejecución. En producción render.yaml lo fija en 'production'
NODE_ENV=development

# Autenticación 
ADMIN_TOKEN=cambia-este-token
JWT_SECRET=cambia-este-secreto

# En producción, número de saltos de proxy de confianza (req.ip = XFF[-N]),
# o una lista de subredes/preset (loopback, linklocal, uniquelocal). No usar 'true'. 
# 'false' en desarrollo sin proxy; 
TRUST_PROXY=3
# Origenes permitidos por CORS, separados por coma. Vacío = sin cabeceras CORS
# (el frontend y la API viven en el mismo origen en producción).
CORS_ORIGIN=

# SMTP para verificar el correo y restablecer la contraseña (ej. Brevo).
SMTP_URL=smtp://usuario:clave@smtp-relay.brevo.com:587
MAIL_FROM=Ayuda Colombia <no-responder@tudominio.com>
# URL pública del frontend (se usa en los enlaces de los correos).
FRONTEND_URL=http://localhost:5173

# Supabase Storage para las fotos de personas y mascotas desaparecidas.
# Si SUPABASE_URL y SUPABASE_SECRET_KEY están vacíos, la foto se guarda
# como base64 en la base de datos (modo de desarrollo/fallback).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=