DATABASE_URL=postgresql://ayudas:ayudas@localhost:5432/ayudas
DATABASE_URL_TEST=postgresql://ayudas:ayudas@localhost:5432/ayudas_test
PORT=4000
ADMIN_TOKEN=cambia-este-token
# Secreto para firmar las cookies de sesión del personal. Genera uno largo
# con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto
# Habilitar solo detrás de un proxy reverso (nginx/caddy). Protege los
# límites de tasa leyendo X-Forwarded-For.
TRUST_PROXY=false
# Supabase Storage para las fotos de personas y mascotas desaparecidas.
# Si SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY están vacíos, la foto se guarda
# como base64 en la base de datos (modo de desarrollo/fallback).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos